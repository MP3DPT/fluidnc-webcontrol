      "options": [{ "value": "usb", "label": "USB webcam (on this Pi)" }, { "value": "ip-mjpeg", "label": "IP camera (MJPEG URL)" }]
    },
    { "key": "camera4Device", "type": "text", "label": "Device path", "placeholder": "/dev/video0", "default": "/dev/video0", "showIf": { "camera4Enabled": true, "camera4Source": "usb" } },
    {
      "key": "camera4Resolution", "type": "select", "label": "Resolution", "default": "1280x720", "showIf": { "camera4Enabled": true, "camera4Source": "usb" },
      "options": [{ "value": "640x480", "label": "640x480 (lower quality, less bandwidth)" }, { "value": "1280x720", "label": "1280x720 (recommended)" }, { "value": "1920x1080", "label": "1920x1080 (highest quality, more bandwidth)" }]
    },
    { "key": "camera4AutoFocus", "type": "checkbox", "label": "Autofocus", "default": true, "showIf": { "camera4Enabled": true, "camera4Source": "usb" } },
    { "key": "camera4FocusValue", "type": "number", "label": "Manual focus", "default": 30, "showIf": { "camera4Enabled": true, "camera4Source": "usb", "camera4AutoFocus": false } },
    { "key": "camera4Url", "type": "text", "label": "Stream URL", "placeholder": "http://192.168.1.50/video", "default": "", "showIf": { "camera4Enabled": true, "camera4Source": "ip-mjpeg" } },

    {
      "type": "hint",
      "text": "Focus is only available for USB webcams that support it (like the Logitech StreamCam) - if the fields don't seem to do anything, your camera likely has a fixed-focus lens."
    },
    {
      "type": "hint",
      "text": "Not sure which /dev/videoN is your camera? Use \"List USB Cameras\" below - USB webcams often expose more than one device node, only one of which actually captures video."
    }
  ],
  "actions": [
    { "id": "list-usb-cameras", "label": "List USB Cameras" }
  ]
}
